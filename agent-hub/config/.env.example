# -----------------------------------------------------------------------------
# agent-hub secrets.
#
# HOW TO USE:
#   1. Copy this file to ".env" in the same folder:
#        cp config/.env.example config/.env
#   2. Fill in the two values below.
#   3. Never commit config/.env — it's already listed in .gitignore.
#
# Don't have a Telegram bot yet? See study/06-telegram-setup.md for a
# step-by-step guide. agent-hub still runs fine without these set — it just
# logs a warning instead of sending messages.
# -----------------------------------------------------------------------------

# The token @BotFather gives you when you create a bot. Looks like:
#   123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=

# The chat the bot should send messages to (your personal chat id, a group id,
# etc.). study/06-telegram-setup.md shows how to find this number.
TELEGRAM_CHAT_ID=
